{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "uw",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/login",
      "/logout",
      "/tags",
      "/index.html",
      "/Tags.html",
      "/haya-karima-viewer.html",
      "/outage-generator.html",
      "/outage-generator.protected.html",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
