# Cloudflare Workers Static Assets headers.
# Stable app JS/CSS filenames must revalidate so hotfixes are visible after deploy.
# Heavy binary assets can stay cached aggressively because their filenames are stable content assets.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: SAMEORIGIN
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/*.html
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

/*.mjs
  Cache-Control: no-cache, must-revalidate

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=2592000, immutable

/css/*
  Cache-Control: no-cache, must-revalidate

/*.png
  Cache-Control: public, max-age=2592000, immutable

/*.webp
  Cache-Control: public, max-age=2592000, immutable

/*.jpg
  Cache-Control: public, max-age=2592000, immutable

/*.jpeg
  Cache-Control: public, max-age=2592000, immutable

/*.gif
  Cache-Control: public, max-age=2592000, immutable

/*.ico
  Cache-Control: public, max-age=2592000, immutable

/*.svg
  Cache-Control: public, max-age=2592000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store

/reactions/*
  Cache-Control: public, max-age=2592000, immutable
